# ---------------------------------------------------------------------------
# Tapo Cloud Personal — configuration (copy to .env)
# Every TAPOCLOUD_* variable is optional; sensible defaults apply.
# ---------------------------------------------------------------------------

# --- Docker only -------------------------------------------------------------
# LAN IP of the machine running Docker (needed for WebRTC through the bridge network).
HOST_LAN_IP=192.168.1.10
UI_PORT=8080
# Where recordings are stored on the host (big disk / NAS share).
RECORDINGS_PATH=./recordings
# Your LAN for the optional camera port-scan (Docker cannot see it by itself).
TAPOCLOUD_SCAN_NETWORKS=192.168.1.0/24

# --- Secrets (generate once and keep a backup!) -------------------------------
# Shared secret between backend, camera-service and MediaMTX:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TAPOCLOUD_INTERNAL_TOKEN=
# Key that encrypts camera passwords and Google tokens (Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Native installs generate it automatically in the data folder if left empty.
TAPOCLOUD_MASTER_KEY=

# --- Google Drive (can also be set from the UI) -------------------------------
TAPOCLOUD_GOOGLE_CLIENT_ID=
TAPOCLOUD_GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console.
# Native install: http://localhost:8000/api/google/callback
# Docker:         http://localhost:8080/api/google/callback
TAPOCLOUD_GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# --- Database -------------------------------------------------------------------
# Default: SQLite inside the data folder. For PostgreSQL (docker --profile postgres):
# TAPOCLOUD_DATABASE_URL=postgresql+psycopg://tapocloud:change-me@database:5432/tapocloud
# POSTGRES_PASSWORD=change-me

# --- Security ---------------------------------------------------------------------
# true when the UI is served over HTTPS (Caddy profile, Tailscale serve...)
TAPOCLOUD_SECURE_COOKIES=false
# Allow cameras outside private IP ranges (not recommended)
TAPOCLOUD_ALLOW_PUBLIC_CAMERA_IPS=false

# --- Experimental -----------------------------------------------------------------
# Enables the separate tapo-lab module (EXPERIMENTAL, see tapo-lab/README.md)
TAPOCLOUD_TAPO_LAB_ENABLED=false

TAPOCLOUD_LOG_LEVEL=INFO
