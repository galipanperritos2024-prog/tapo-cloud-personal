# Optional HTTPS front door for the LAN / Tailscale (docker compose --profile proxy).
# "tls internal" issues a certificate from Caddy's own local CA: install its root
# certificate on your devices once, or use `tailscale cert` for a trusted one.
# Remember to set TAPOCLOUD_SECURE_COOKIES=true in .env when using HTTPS.
{
	auto_https disable_redirects
}

https:// {
	tls internal {
		on_demand
	}
	encode gzip
	reverse_proxy frontend:8080
}
